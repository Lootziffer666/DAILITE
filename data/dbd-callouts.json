  "communication_callouts": {
    "enemy_communication": {
      "killer_location": {
        "format": "[Killer] at [Clock Position]",
        "example": "Spirit at 3 o'clock near Gas Heaven",
        "use_case": "Alert team to killer location"
      },
      "chase": {
        "callouts": ["Chase at [Location]", "In chase at [Clock Position]"],
        "use_case": "Communicate active chase happening"
      },
      "hook": {
        "format": "[Survivor] hooked at [Location]",
        "example": "Jake hooked at 12 o'clock",
        "use_case": "Locate hooked teammate"
      }
    },
    "objective_communication": {
      "generators": {
        "callouts": ["Gen at [Clock Position]", "[Location] gen"],
        "example": "Gen at 3 o'clock, Gas Heaven area",
        "use_case": "Coordinate generator focus"
      },
      "exit_gates": {
        "callouts": ["Gates at [Clock Position]", "North gate spawned"],
        "use_case": "Communicate exit gate locations"
      },
      "cleansing": {
        "callouts": ["Totem at [Location]", "Hex at [Clock Position]"],
        "use_case": "Call totem/hex locations"
      }
    },
    "strategy_callouts": {
      "three_gen": {
        "meaning": "Three generators close together - survivor disadvantage",
        "strategy": "Avoid letting killer lock down these 3 gens",
        "example": "3-gen at Coal, Gas, and Wreckers"
      },
      "pallet_town": {
        "meaning": "Area with many pallets close together",
        "strategy": "Good for looping, risky for survivors"
      },
      "dead_zone": {
        "meaning": "Area with minimal pallets/resources",
        "strategy": "Dangerous for survivors to get caught here"
      },
      "safe_zone": {
        "meaning": "Area with many resources for survivor advantage",
        "strategy": "Good landing spot if injured"
      }
    }
  },

